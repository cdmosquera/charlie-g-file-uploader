# Copy this file to .env and fill it in.

# Public address of this app (no trailing slash). Must match the redirect URI
# you registered in Google Cloud: <BASE_URL>/auth/google/callback
BASE_URL=http://localhost:3000
PORT=3000
# Network interface to listen on. Use 127.0.0.1 behind a reverse proxy.
HOST=0.0.0.0

# From Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login for the /admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Any long random string (used to sign login cookies and upload tokens)
SESSION_SECRET=replace-with-a-long-random-string

# Where the app keeps its data (links, upload log, your Drive refresh token)
DATA_DIR=./data
